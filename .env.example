# BurnSignal Environment Configuration Template
# Copy to .env and fill in real values where needed

# Google Cloud Platform Configuration
GCP_PROJECT_ID=burnsignal-prod
PILOT_DISTRICT_CODE=PB-SANGRUR

# BigQuery Dataset Identifiers
BQ_DATASET_RAW=burnsignal_raw
BQ_DATASET_FEATURES=burnsignal_features
BQ_DATASET_SCORING=burnsignal_scoring
BQ_DATASET_REGISTRY=burnsignal_registry

# ML Propensity Scoring & Hotspot Clustering
VERTEX_ENDPOINT_ID=
BURN_SCORE_THRESHOLD=0.60
CLUSTER_EPS_METERS=500
CLUSTER_MIN_SAMPLES=3
EQUIPMENT_MAX_DISTANCE_KM=15.0

# Vernacular TTS & Audio Storage
TTS_LANGUAGE_CODE=pa-IN
GCS_AUDIO_BUCKET=burnsignal-audio
GCS_IMAGERY_BUCKET=burnsignal-imagery

# API Keys (Optional - fallbacks provided for local offline execution)
CARTO_API_KEY=
GEMINI_TTS_API_KEY=
EE_SERVICE_ACCOUNT_KEY=
